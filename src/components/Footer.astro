---
import { contact, person, social } from "../data/site";
import { siGithub, siInstagram } from "simple-icons";
// social glyphs: Simple Icons (CC0) for GitHub / Instagram; LinkedIn was removed from Simple Icons,
// so its standard "in" mark is inlined (viewBox cropped to the letters)
const glyphs: Record<string, { vb: string; d: string }> = {
  GitHub: { vb: "0 0 24 24", d: siGithub.path },
  Instagram: { vb: "0 0 24 24", d: siInstagram.path },
  LinkedIn: { vb: "3 3 18 18", d: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z" },
};
---
<footer class="foot" id="contact" data-theme="dark" data-foot string="progress" string-id="foot" string-exit-vp="top" string-exit-el="top">
  <svg class="foot__octa" viewBox="0 0 1440 1400" preserveAspectRatio="none" aria-hidden="true">
    <path d="M300 0 L1140 0 L1440 300 L1440 1100 L1140 1400 L300 1400 L0 1100 L0 300 Z" fill="none" stroke="rgba(255,255,255,.08)" />
    <path d="M420 120 L1020 120 L1320 420 L1320 980 L1020 1280 L420 1280 L120 980 L120 420 Z" fill="none" stroke="rgba(255,255,255,.05)" />
  </svg>
  <div class="grid foot__w">
    <h2 class="foot__h">
      <span class="foot__hl t-h3 display">{contact.left}</span>
      <svg class="foot__string" data-pluck viewBox="0 0 1000 80" preserveAspectRatio="none" aria-hidden="true" data-cursor="cursor-pluck">
        <path d="M0 40 Q500 40 1000 40" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="1" vector-effect="non-scaling-stroke" />
      </svg>
      <span class="foot__hr t-h3 display">{contact.right}</span>
    </h2>
    {contact.statements.map((s, i) => <p class={`foot__st foot__st--${i + 1} t-h6`}>{s}</p>)}
    <a class="foot__more t-mm" href={contact.more.href} target="_blank" rel="noopener" data-cursor="cursor-newtab">{contact.more.label} ↗</a>

    <nav class="foot__nav" aria-label="Contact">
      <a class="pill" href={`mailto:${person.email}`} data-cursor="cursor-newtab">{person.email}</a>
      {social.map((s) => { const gl = glyphs[s.label]; return <a class="pill -round foot__soc" href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label} data-cursor="cursor-newtab">{gl ? <svg viewBox={gl.vb} aria-hidden="true"><path d={gl.d} /></svg> : s.short}</a>; })}
    </nav>

    <div class="foot__name">
      <span class="foot__c" aria-hidden="true">©</span>
      <span class="t-lrg foot__mirror" aria-hidden="true">{person.name}</span>
      <span class="foot__jp t-h6" lang="ja">アーリアン<span class="foot__jp-dot">・</span>ヴェルマ</span>
    </div>
    {contact.subs.map((s, i) => <span class={`foot__sub foot__sub--${i + 1} t-mm`}>{s}</span>)}

    <figure class="foot__poly" string="parallax" string-parallax="-0.15">
      <img src="/media/footer-f1.webp" alt="Aryan with a Red Bull Formula 1 show car" width="863" height="575" loading="lazy" />
    </figure>
    <a class="foot__top t-mm" href="#top">Back to top ↑</a>
  </div>
</footer>

<style is:global>
  .foot { position: relative; background: var(--c-ink); color: var(--c-white); overflow: hidden; padding-top: 6rem; }
  .foot__octa { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .foot__w { position: relative; row-gap: 1.6rem; }
  .foot__h { --left: 1; --width: 12; grid-row: 1; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; font-weight: 500; }
  .foot__string { width: 100%; height: 5rem; overflow: visible; touch-action: pan-y; }
  .foot__st { grid-row: 2; position: relative; margin-top: 2.4rem; }
  .foot__st::before { content: "+"; position: absolute; left: -.9rem; top: -1.2rem; font-size: var(--mm); color: var(--c-grey); }
  .foot__st--1 { --left: 2; --width: 3; }
  .foot__st--2 { --left: 6; --width: 3; }
  .foot__st--3 { --left: 10; --width: 3; }
  .foot__more { --left: 10; --width: 3; grid-row: 3; color: var(--c-grey); transition: color .3s; }
  .foot__more:hover { color: var(--c-white); }
  .foot__nav { --left: 0; --width: var(--cols); grid-row: 4; display: flex; justify-content: center; gap: .4rem; margin-top: 3rem; flex-wrap: wrap; }
  .foot__soc { font-size: var(--mm); }
  .foot__soc svg { width: 44%; height: 44%; fill: currentColor; display: block; }

  .foot__name { grid-row: 5; position: relative; display: grid; place-items: center; margin-top: 2rem; }
  .foot__name > * { grid-area: 1 / 1; }
  .foot__mirror { color: rgba(var(--c-mute-rgb), .35); scale: -1 1; white-space: nowrap; font-size: min(var(--lrg), 15vw); }
  .foot__jp { color: var(--c-white); align-self: start; margin-top: 18%; font-family: var(--font-jp); font-weight: 900; font-size: var(--h3); line-height: 1.1; letter-spacing: -.03em; white-space: nowrap; max-width: 100%;
    /* outline only: a 2px stroke painted under a fill in the page colour leaves a clean 1px contour (hides overlapping glyph parts) */
    color: var(--c-ink); -webkit-text-stroke: 2.2px rgba(var(--c-white-rgb), .24); paint-order: stroke fill; }
  .foot__jp-dot { margin-inline: -.22em; } /* the full-width ・ leaves a wide gap at display size */
  @media (max-width: 640px) { .foot__jp { font-size: min(var(--h3), 8.4vw); } }
  .foot__c { justify-self: start; align-self: start; margin-left: 4%; width: 2.4rem; height: 2.4rem; border: 2px solid var(--c-mute); border-radius: 50%; display: grid; place-items: center; color: var(--c-mute); font-size: var(--h6); }
  .foot__sub { grid-row: 6; color: var(--c-grey); }
  .foot__sub--1 { --left: 0; --width: 4; } .foot__sub--2 { --left: 4; --width: 4; } .foot__sub--3 { --left: 8; --width: 4; } .foot__sub--4 { --left: 12; --width: 2; text-align: right; }
  .foot__poly {
    --left: 4; --width: 6; grid-row: 7; margin: 4rem 0 0; aspect-ratio: 1.15;
    clip-path: polygon(30% 0, 70% 0, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0 70%, 0 30%);
    overflow: hidden; margin-bottom: -6rem;
  }
  .foot__poly img { width: 100%; height: 100%; object-fit: cover; object-position: 38% 50%; } /* keeps Aryan clear of the cut corners */
  .foot__top { --left: 12; --width: 2; grid-row: 7; align-self: end; justify-self: end; margin-bottom: 2rem; color: var(--c-grey); position: relative; z-index: 2; }
  @media (max-width: 1023px) {
    .foot__h { --left: 0; --width: 6; }
    .foot__st { --left: 0 !important; --width: 6 !important; grid-row: auto; margin-top: 1rem; padding-left: 1rem; }
    .foot__st::before { left: 0; top: 0; }
    .foot__more { --left: 0; --width: 6; grid-row: auto; }
    .foot__nav { grid-row: auto; }
    .foot__name { grid-row: auto; }
    .foot__c { display: none; }
    .foot__sub { grid-row: auto; --left: 0 !important; --width: 6 !important; text-align: left !important; }
    .foot__poly { --left: 0; --width: 6; grid-row: auto; }
    .foot__top { grid-row: auto; --left: 0; --width: 6; justify-self: start; }
  }
</style>
