---
import { story } from "../data/site";
const fmt = (s: string) => s.replace(/\*\*(.+?)\*\*/g, "<mark>$1</mark>");
---
<section class="story" data-verse="story" data-story data-theme="dark" data-theme-top aria-label="About Aryan">
  <div class="story__sticky">
    <canvas class="story__band" data-band data-src="/media/story-sunset-street.webp" data-focus-y="0.78" aria-hidden="true"></canvas>
    <div class="story__bars" data-bars aria-hidden="true"><i></i><span class="story__rest" data-band-rest></span></div>
    <div class="grid story__dock">
      <figure class="story__who">
        <!-- pixelated like the hero guide (ui.ts pixelate: downsample + posterise); the canvas is the avatar -->
        <canvas width="16" height="24" data-pixel-src="/media/aryan-portrait.webp" data-pixel-cols="16" role="img" aria-label="Portrait of Aryan Verma"></canvas>
        <figcaption class="t-mm">{story.speaker}</figcaption>
      </figure>
      <div class="story__talk">
        <p class="story__line t-h6" data-line aria-live="polite"></p>
        <ol class="story__ticks" aria-hidden="true">{story.lines.map(() => <li></li>)}</ol>
      </div>
      <button class="pill story__skip" type="button" data-skip>Skip</button>
    </div>
    <canvas class="story__wipe" data-wipe aria-hidden="true"></canvas>
  </div>
  <ol class="sr-only">{story.lines.map((l) => <li set:html={fmt(l)} />)}</ol>
  <script type="application/json" data-lines set:html={JSON.stringify(story.lines.map(fmt))} />
</section>

<style is:global>
  .story { position: relative; height: calc(var(--vh) * 1100); z-index: 20; }
  .story__sticky { position: sticky; top: 0; height: calc(var(--vh) * 100); overflow: hidden; }
  /* the panorama fills the screen; black bars slide in from the top & bottom to letterbox it */
  .story { --bt: 21%; --bb: 21%; }
  .story__band { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* stacking: panorama → paper wipe (1) → black bars (2) → dialogue (3); the wipe only ever shows inside the letterbox */
  .story__bars { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 2; }
  .story__bars i { position: absolute; inset: 0; box-shadow: 0 0 0 200vmax var(--c-ink); }
  .story__bars .story__rest { position: absolute; left: 0; right: 0; top: var(--bt); bottom: var(--bb); visibility: hidden; }
  .story__dock { opacity: var(--out, 1); position: absolute; z-index: 3; inset: auto 0 0 0; height: 21%; align-items: center; padding-bottom: .6rem; }
  .story__who { --left: 3; --width: 1; display: flex; flex-direction: column; align-items: center; gap: .35rem; justify-self: end; margin-right: 1.6rem; /* room before the dialogue */ opacity: 0; translate: 0 1rem; transition: opacity .6s, translate .6s var(--e-cubic); }
  .story__who canvas { width: 3.4rem; height: 4.4rem; object-fit: cover; border-radius: .4rem; image-rendering: pixelated; filter: grayscale(.2); }
  .story__who figcaption { color: var(--c-mute); font-size: calc(var(--mm) * 1.2); white-space: nowrap; }
  .story__talk { --left: 4; --width: 4; align-self: center; display: flex; flex-direction: column; gap: .8rem; opacity: 0; transition: opacity .6s; }
  .story.-live .story__who { opacity: 1; translate: 0 0; }
  .story.-live .story__talk { opacity: 1; }
  .story__line { min-height: 3.6em; color: var(--c-white); }
  .story__line mark { background: rgba(var(--c-white-rgb), .16); color: inherit; padding: 0 .2em; border-radius: .25em; }
  .story__line .caret { display: inline-block; width: .45em; height: .9em; background: currentColor; margin-left: .1em; animation: blink 1s steps(1) infinite; }
  .story__ticks { display: flex; gap: 2px; width: 7rem; }
  .story__ticks li { flex: 1; height: 2px; background: rgba(var(--c-white-rgb), .15); transition: background .4s; }
  .story__ticks li.-on { background: var(--c-white); }
  .story__skip { --left: 13; --width: 1; justify-self: end; align-self: end; height: 1.2rem; font-size: var(--m); }
  .story.-out .story__dock { pointer-events: none; }
  .story__wipe { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
  @media (max-width: 1023px) {
    .story { --bt: 16%; --bb: 34%; }
    .story__dock { height: 34%; align-content: center; row-gap: .6rem; padding-bottom: max(.8rem, env(safe-area-inset-bottom, .8rem)); }
    .story__who { --left: 0; --width: 1; justify-self: start; margin-right: .4rem; }
    .story__who canvas { width: 2.8rem; height: 3.8rem; }
    .story__talk { --left: 1; --width: 5; gap: .5rem; }
    .story__line { min-height: 4.4em; font-size: clamp(0.95rem, 3.8vw, 1.12rem); line-height: 1.35; }
    .story__skip { --left: 4; --width: 2; grid-row: 2; justify-self: end; height: 1.4rem; font-size: var(--mm); padding: 0 .8rem; }
  }
</style>
