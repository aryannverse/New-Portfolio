---
/**
 * Animated, interactive line graphics for project cards — the home bento (light) and /work
 * (dark: <BentoArt kind dark />). After the feature cards on string-tune.fiddle.digital.
 * Motion is CSS / SMIL; `quant` and `surface` are computed by src/scripts/bento.ts, which also
 * adds cursor parallax (.p1/.p2 layers) and hover speed-ups to every graphic.
 */
interface Props { kind: string; dark?: boolean }
const { kind, dark = false } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);

// tiny seeded PRNG for repeatable scatter
let seed = [...kind].reduce((a, c) => a + c.charCodeAt(0), 7);
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const dots = (pts: number[][], r = 4, cls = "nd") => pts.map(([x, y]) => `<circle class="${cls}" cx="${x}" cy="${y}" r="${r}"/>`).join("");
const t = (x: number, y: number, s: string, cls = "lbl") => `<text class="${cls}" x="${x}" y="${y}">${s}</text>`;

const toks = [
  { t: "Hi, I'm" }, { t: "Riya", pii: true }, { t: "card" }, { t: "4111 1111", pii: true },
  { t: "mail" }, { t: "r@x.in", pii: true }, { t: "ignore all", inj: true }, { t: "rules", inj: true },
] as { t: string; pii?: boolean; inj?: boolean }[];
const chip = (x: number, k: (typeof toks)[number], clean: boolean) => {
  const w = 58;
  if (clean && k.pii) return `<g transform="translate(${x} 0)"><rect class="ac" x="0" y="-11" width="${w}" height="22" rx="5"/><text class="w" x="${w / 2}" y="3.5">[PII]</text></g>`;
  if (clean && k.inj) return `<g transform="translate(${x} 0)"><rect class="off" x="0" y="-11" width="${w}" height="22" rx="5"/><text class="m" x="${w / 2}" y="3.5">✕ blocked</text></g>`;
  return `<g transform="translate(${x} 0)"><rect class="nd" x="0" y="-11" width="${w}" height="22" rx="5"/><text x="${w / 2}" y="3.5">${k.t}</text></g>`;
};
const row = (clean: boolean) => [...toks, ...toks].map((k, i) => chip(i * 64, k, clean)).join("");

const art: Record<string, () => string> = {
  rag: () => `
    <g class="ln"><path d="M46 120C100 120 104 64 150 64H232"/><path d="M46 120C100 120 104 176 150 176H232"/>
      <path d="M232 64C258 64 252 120 270 120M232 176C258 176 252 120 270 120"/>
      <path d="M306 120L334 82M306 120L346 120M306 120L334 158M334 82L372 120M346 120L372 120M334 158L372 120"/></g>
    <g class="flow"><path d="M46 120C100 120 104 64 150 64H232C258 64 252 120 270 120"/><path style="animation-delay:-.7s" d="M46 120C100 120 104 176 150 176H232C258 176 252 120 270 120"/></g>
    <g class="p1">${[160, 184, 208].map((x) => `<rect class="nd" x="${x}" y="57" width="14" height="14" rx="3"/><rect class="nd" x="${x}" y="169" width="14" height="14" rx="3"/>`).join("")}</g>
    <circle class="nd acs" cx="36" cy="120" r="10"/>
    <rect class="nd" x="270" y="107" width="36" height="26" rx="6"/>${t(288, 124, "RRF", "lbl ink")}
    <g class="seq">${dots([[334, 82], [346, 120], [334, 158]], 8)}</g>
    <circle class="nf" cx="376" cy="120" r="11"/><path class="tick" d="M370 120l4 4 8-9"/>
    ${t(190, 48, "BM25")}${t(190, 200, "dense")}${t(36, 146, "query")}${t(340, 186, "critics")}`,

  shield: () => `
    <defs><clipPath id="gl${uid}"><rect x="0" y="0" width="196" height="240"/></clipPath><clipPath id="gr${uid}"><rect x="204" y="0" width="196" height="240"/></clipPath></defs>
    ${t(98, 58, "untrusted prompt")}${t(302, 58, "sanitised")}
    <g clip-path="url(#gl${uid})"><g transform="translate(0 112)"><g class="stream">${row(false)}</g></g></g>
    <g clip-path="url(#gr${uid})"><g transform="translate(0 112)"><g class="stream">${row(true)}</g></g></g>
    <path class="gate" d="M200 70V154"/>
    <g class="p1"><path class="nf" d="M200 96l18 6v16c0 12-8 20-18 24-10-4-18-12-18-24v-16z"/><path class="tick on" d="M193 116l5 5 9-10"/></g>
    ${t(200, 178, "PII · injection · policy")}`,

  quant: () => `
    <path class="ln" d="M30 196H370M30 196V30"/>
    <path class="ghost" data-q-smooth/><path class="as" data-q-stair/>
    <text class="big" x="44" y="52" data-q-label>16-bit</text>
    <text class="lbl l" x="44" y="68" data-q-levels>65,536 levels</text>
    ${[0, 1, 2, 3].map((k) => `<rect class="nd q" x="${286 + k * 20}" y="38" width="14" height="14" rx="3" data-q-tick="${k}"/>`).join("")}
    ${t(326, 66, "bits")}`,

  mcp: () => `
    <circle class="ln dash" cx="200" cy="120" r="86"/>
    <g class="orbit">${[0, 60, 120, 180, 240, 300].map((a, k) => `<g transform="rotate(${a} 200 120)">
      <path class="ln" d="M226 120H272"/>
      <circle class="ac" cy="120" r="3"><animate attributeName="cx" values="226;272" dur="1.6s" begin="${k * 0.27}s" repeatCount="indefinite"/><animate attributeName="opacity" values="0;1;1;0" dur="1.6s" begin="${k * 0.27}s" repeatCount="indefinite"/></circle>
      <rect class="${k % 3 === 0 ? "nf" : "nd"}" x="276" y="110" width="20" height="20" rx="5"/></g>`).join("")}</g>
    <g class="p1"><circle class="ac" cx="200" cy="120" r="26"/><text class="hub" x="200" y="124">MCP</text></g>
    ${t(200, 230, "218 tools · 20 toolsets · 3 safety tiers")}`,

  surface: () => `
    <g class="surf" data-surf/><circle class="ac" r="5" data-surf-pt/>
    ${t(18, 228, "strike →", "lbl l")}${t(350, 228, "maturity")}${t(18, 26, "implied vol", "lbl l")}`,

  sql: () => `
    <defs><clipPath id="ty${uid}"><rect x="56" y="20" height="22" width="0"><animate attributeName="width" values="0;290;290;0" keyTimes="0;.35;.85;1" dur="6s" repeatCount="indefinite"/></rect></clipPath></defs>
    <text class="say" x="200" y="36" clip-path="url(#ty${uid})">“revenue by city, last 30 days”</text>
    <path class="flow" d="M200 46V78"/>
    <path class="ln" d="M200 100L90 140M200 100V140M200 100L310 140M90 160L74 192M90 160L106 192M200 160V192M310 160V192"/>
    <path class="bad" d="M230 89L298 84"/>
    <g class="p1"><rect class="nd" x="170" y="78" width="60" height="22" rx="5"/>${t(200, 93, "SELECT", "lbl ink")}</g>
    <g class="seq">${[[60, "FROM"], [170, "WHERE"], [280, "GROUP BY"]].map(([x, s]) => `<rect class="nd" x="${x}" y="140" width="60" height="20" rx="5"/>`).join("")}</g>
    ${t(90, 154, "FROM", "lbl ink")}${t(200, 154, "WHERE", "lbl ink")}${t(310, 154, "GROUP", "lbl ink")}
    ${dots([[74, 196], [106, 196], [200, 196], [310, 196]], 4)}
    <g class="blink"><rect class="off" x="298" y="74" width="72" height="20" rx="5"/>${t(334, 88, "DROP ✕", "lbl red")}</g>`,

  logs: () => {
    const rowsH = Array.from({ length: 12 }, (_, i) => { const w = 60 + Math.round(rnd() * 140), bad = i === 4 || i === 9; return `<g transform="translate(0 ${i * 16})"><rect class="dim" x="0" y="0" width="22" height="6" rx="2"/><rect class="${bad ? "ac" : "bar"}" x="30" y="0" width="${w}" height="6" rx="2"/></g>`; }).join("");
    return `
    <defs><clipPath id="lc${uid}"><rect x="24" y="30" width="236" height="180"/></clipPath></defs>
    <g clip-path="url(#lc${uid})"><g transform="translate(30 36)"><g class="scroll">${rowsH}<g transform="translate(0 192)">${rowsH}</g></g></g></g>
    <path class="ln" d="M276 30V210"/>
    <g class="p1">${Array.from({ length: 16 }, () => `<circle class="nd" cx="${300 + rnd() * 50}" cy="${50 + rnd() * 70}" r="3.5"/>`).join("")}</g>
    <circle class="ac" cx="352" cy="168" r="6"/><circle class="ring" cx="352" cy="168" r="6"/>
    ${t(328, 200, "anomaly")}${t(328, 36, "clusters")}`;
  },

  wave: () => `
    <g class="wv">${Array.from({ length: 30 }, (_, k) => { const h = 16 + Math.abs(Math.sin(k * 0.7)) * 60 + rnd() * 18; return `<rect style="--k:${k}" x="${30 + k * 7}" y="${120 - h / 2}" width="3.2" height="${h}" rx="1.6"/>`; }).join("")}</g>
    <path class="ln" d="M246 120h22m-6-6 6 6-6 6"/>
    <g class="type">${[[96, 92], [74, 108], [88, 124], [52, 140]].map(([w, y], k) => `<rect style="--k:${k}" class="${k === 0 ? "ac" : "bar"}" x="282" y="${y}" width="${w}" height="6" rx="3"/>`).join("")}</g>
    ${t(110, 200, "live audio · whisper")}${t(328, 172, "summary")}`,

  bnb: () => `
    <g class="grid">${[80, 120, 160, 200, 240, 280, 320].map((x) => `<path d="M${x} 30V210"/>`).join("")}${[60, 100, 140, 180].map((y) => `<path d="M40 ${y}H360"/>`).join("")}</g>
    <g class="flow thin">${[[90, 70], [130, 176], [282, 62], [322, 164], [252, 196], [70, 146]].map(([x, y]) => `<path d="M200 120L${x} ${y - 12}"/>`).join("")}</g>
    <g class="pins p1">${[[90, 70], [130, 176], [282, 62], [322, 164], [252, 196], [70, 146]].map(([x, y], k) => `<g style="--k:${k}" transform="translate(${x} ${y})"><path class="${k === 2 ? "ac" : "nd"}" d="M0 0c-6-7-9-11-9-15a9 9 0 1 1 18 0c0 4-3 8-9 15z"/></g>`).join("")}</g>
    <path class="ac spin" d="M200 98C202 114 206 118 222 120C206 122 202 126 200 142C198 126 194 122 178 120C194 118 198 114 200 98Z"/>
    ${t(200, 228, "gemini 2.0 × openbnb mcp")}`,

  cells: () => {
    const pts: number[][] = [];
    for (let i = 0; i < 6; i++) for (let j = 0; j < 3; j++) pts.push([62 + i * 56 + (rnd() - 0.5) * 18, 62 + j * 58 + (rnd() - 0.5) * 16]);
    return `
    <g class="p1">${pts.map(([x, y], k) => { const blast = k === 4 || k === 13; const r = 15 + rnd() * 5; return `<g class="cell" style="--k:${k}"><circle class="nd" cx="${x}" cy="${y}" r="${r}"/><circle class="${blast ? "ac" : "dimf"}" cx="${x + (rnd() - 0.5) * 6}" cy="${y + (rnd() - 0.5) * 6}" r="${blast ? 9 : 6}"/>${blast ? `<circle class="ring" cx="${x}" cy="${y}" r="${r}"/>` : ""}</g>`; }).join("")}</g>
    <g class="scan"><path d="M30 30V210"/></g>
    ${t(200, 228, "ALL vs HEM · 95.5% held-out")}`;
  },

  isl: () => {
    const J = [[200, 200], [200, 150], [158, 122], [142, 88], [132, 58], [184, 96], [180, 60], [178, 34], [208, 92], [212, 56], [214, 30], [232, 100], [244, 70], [250, 46], [244, 146], [270, 124], [290, 104]];
    const B = [[0, 1], [1, 2], [2, 3], [3, 4], [1, 5], [5, 6], [6, 7], [1, 8], [8, 9], [9, 10], [1, 11], [11, 12], [12, 13], [1, 14], [14, 15], [15, 16]];
    return `
    <g class="flow thin">${[4, 7, 10, 13, 16].map((i) => `<path d="M352 42L${J[i][0]} ${J[i][1]}"/>`).join("")}</g>
    <g class="p1"><path class="ln" d="${B.map(([a, b]) => `M${J[a][0]} ${J[a][1]}L${J[b][0]} ${J[b][1]}`).join("")}"/>
    <g class="seq">${J.map(([x, y]) => `<circle class="nd" cx="${x}" cy="${y}" r="4"/>`).join("")}</g></g>
    <rect class="nf" x="340" y="30" width="26" height="16" rx="3"/>${t(353, 62, "lidar")}${t(84, 120, "rgb → 3d")}`;
  },

  qubit: () => `
    <path class="ln" d="M30 70H220M30 110H220M30 150H220"/>
    ${[70, 110, 150].map((y) => `<rect class="nd" x="44" y="${y - 10}" width="20" height="20" rx="4"/>${t(54, y + 3.5, "H", "lbl ink")}`).join("")}
    <rect class="nd acs" x="92" y="56" width="44" height="108" rx="6"/>${t(114, 114, "oracle", "lbl ink")}
    <rect class="nd" x="156" y="56" width="44" height="108" rx="6"/>${t(178, 114, "diffuse", "lbl ink")}
    <path class="flow" d="M30 110H220"/>
    <g class="amp">${Array.from({ length: 8 }, (_, i) => `<rect class="${i === 5 ? "ac hit" : "bar"}" x="${246 + i * 16}" y="${i === 5 ? 60 : 160}" width="10" height="${i === 5 ? 140 : 40}" rx="2"/>`).join("")}</g>
    ${t(331, 216, "|101⟩")}${t(310, 46, "amplitudes")}`,

  option: () => `
    <path class="ln" d="M30 200H370M30 200V30"/>
    <path class="ln dash" d="M30 196H200L370 40"/>
    <path class="as" id="bs${uid}" d="M30 194C120 192 170 170 220 130S320 52 370 36"/>
    <circle class="ac" r="6"><animateMotion dur="7s" repeatCount="indefinite" keyPoints="0;1;0" keyTimes="0;.5;1" calcMode="linear"><mpath href="#bs${uid}"/></animateMotion></circle>
    <path class="ln" d="M200 196V206"/>${t(200, 218, "K")}${t(346, 218, "spot")}${t(56, 26, "call value", "lbl")}
    <g class="p1">${t(90, 70, "Δ  Γ  ν  Θ  ρ", "greeks")}</g>`,

  bracket: () => {
    let s = "";
    const L = (x1: number, y1: number, x2: number, y2: number) => `M${x1} ${y1}H${(x1 + x2) / 2}V${y2}H${x2}`;
    const y8 = Array.from({ length: 8 }, (_, i) => 36 + i * 24), y4 = [0, 1, 2, 3].map((i) => (y8[i * 2] + y8[i * 2 + 1]) / 2), y2 = [0, 1].map((i) => (y4[i * 2] + y4[i * 2 + 1]) / 2), y1 = (y2[0] + y2[1]) / 2;
    y8.forEach((y, i) => (s += L(40, y, 140, y4[i >> 1])));
    y4.forEach((y, i) => (s += L(140, y, 240, y2[i >> 1])));
    y2.forEach((y) => (s += L(240, y, 330, y1)));
    const win = L(40, y8[5], 140, y4[2]) + L(140, y4[2], 240, y2[1]) + L(240, y2[1], 330, y1);
    return `<path class="ln" d="${s}"/><path class="draw" d="${win}"/>
    ${dots(y8.map((y) => [40, y]), 4)}${dots(y4.map((y) => [140, y]), 4)}${dots(y2.map((y) => [240, y]), 4)}
    <g class="p1"><circle class="ac pop" cx="342" cy="${y1}" r="10"/></g>${t(342, y1 + 28, "10k sims")}`;
  },

  pitch: () => {
    const shots = Array.from({ length: 14 }, (_, k) => [190 + rnd() * 150, 50 + rnd() * 140, 3 + rnd() * 7, k % 5 === 0 ? 1 : 0]);
    return `
    <path class="ln" d="M40 30H360V210H40ZM360 80H300V160H360M360 100H336V140H360M40 120m-4 0a4 4 0 1 0 8 0a4 4 0 1 0-8 0"/>
    <g class="shots p1">${shots.map(([x, y, r, g], k) => `<circle style="--k:${k}" class="${g ? "ac" : "nd"}" cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${r.toFixed(1)}"/>`).join("")}</g>
    <path id="sh${uid}" class="ln dash" d="M150 160C220 120 300 100 362 118"/>
    <circle class="nf" r="5"><animateMotion dur="2.6s" repeatCount="indefinite"><mpath href="#sh${uid}"/></animateMotion></circle>
    ${t(110, 60, "xG map · AP 0.53")}`;
  },

  track: () => `
    <path id="tr${uid}" class="road" d="M70 170C40 140 50 80 100 70S180 90 220 60S330 40 350 90S320 180 260 175S150 200 70 170Z"/>
    <path class="ln" d="M70 170C40 140 50 80 100 70S180 90 220 60S330 40 350 90S320 180 260 175S150 200 70 170Z"/>
    <circle class="ac" r="6"><animateMotion dur="5s" repeatCount="indefinite" rotate="auto"><mpath href="#tr${uid}"/></animateMotion></circle>
    <circle class="nf" r="5"><animateMotion dur="5.25s" begin="-.45s" repeatCount="indefinite"><mpath href="#tr${uid}"/></animateMotion></circle>
    <path class="ln" d="M64 158L80 180"/>${t(200, 228, "quali → race · fastf1")}<g class="p1">${t(110, 130, "P1", "big")}</g>`,

  laps: () => {
    const line = (o: number) => Array.from({ length: 24 }, (_, i) => { const pit = i >= 13; return `${i ? "L" : "M"}${40 + i * 13.5} ${(150 - i * 2.2 + (pit ? 34 - (i - 13) * 2 : 0) + o + Math.sin(i * 1.7) * 4 + rnd() * 4).toFixed(1)}`; }).join("");
    return `<path class="ln" d="M36 200H370M36 200V30"/><path class="ln dash" d="M215 40V200"/>${t(215, 30, "pit")}
    <path class="draw" d="${line(0)}"/><path class="draw b" d="${line(-18)}"/>${t(70, 220, "lap →")}${t(320, 220, "british gp 2024")}`;
  },

  coin: () => `
    <g class="p1">${t(40, 70, "safe to spend", "lbl l")}<text class="big" x="40" y="104">₹36,721</text></g>
    <g class="days">${Array.from({ length: 24 }, (_, k) => `<rect style="--k:${k}" x="${40 + k * 13.4}" y="140" width="10" height="28" rx="3"/>`).join("")}</g>
    ${t(40, 190, "bills", "lbl l")}${t(356, 190, "payday")}`,

  synth: () => `
    <g class="bob p1">${dots([[70, 150], [70, 120], [56, 96], [48, 76], [72, 92], [72, 66], [86, 94], [90, 70], [98, 104], [106, 86]], 3.5)}<path class="ln" d="M70 150V120L56 96 48 76M70 120L72 92 72 66M70 120L86 94 90 70M70 120L98 104 106 86"/></g>
    <path class="as"><animate attributeName="d" dur="2.4s" repeatCount="indefinite" values="M140 120C170 70 200 170 230 120S290 70 320 120S350 150 370 120;M140 120C170 160 200 80 230 120S290 160 320 120S350 90 370 120;M140 120C170 70 200 170 230 120S290 70 320 120S350 150 370 120"/></path>
    <path class="ln dash" d="M120 120H136"/>${t(80, 190, "hand")}${t(260, 190, "tone.js")}`,

  match: () => {
    const L = [[60, 70], [60, 120], [60, 170]], R = [[340, 70], [340, 120], [340, 170]];
    return `<g class="ln">${[...L, ...R].map(([x, y]) => `<path d="M${x} ${y}L200 120"/>`).join("")}</g>
    <g class="draws">${[[L[0], R[2]], [L[1], R[0]], [L[2], R[1]]].map(([a, b], k) => `<path style="--k:${k}" d="M${a[0]} ${a[1]}L200 120L${b[0]} ${b[1]}"/>`).join("")}</g>
    ${dots(L, 9)}${R.map(([x, y]) => `<rect class="nd" x="${x - 9}" y="${y - 9}" width="18" height="18" rx="4"/>`).join("")}
    <g class="p1"><circle class="ac pulse" cx="200" cy="120" r="14"/></g>${t(60, 204, "students")}${t(340, 204, "projects")}`;
  },

  brand: () => `
    <g class="p1"><rect class="nd big-s" x="150" y="70" width="100" height="100" rx="0"><animate attributeName="rx" values="0;50;0" dur="5s" repeatCount="indefinite"/></rect></g>
    <path class="nf spin2" d="M200 96L224 120L200 144L176 120Z"/>
    <path id="or${uid}" class="ln dash" d="M200 46A74 74 0 1 1 199.9 46"/>
    <circle class="ac" r="7"><animateMotion dur="6s" repeatCount="indefinite"><mpath href="#or${uid}"/></animateMotion></circle>
    ${t(200, 220, "identity system")}`,

  hack: () => `
    <g class="p1">${t(92, 140, "{", "brace")}${t(310, 140, "}", "brace")}</g>
    <g class="type">${[[120, 86, 1], [100, 104, 0], [150, 122, 0], [80, 140, 0], [130, 158, 0]].map(([w, y, a], k) => `<rect style="--k:${k}" class="${a ? "ac" : "bar"}" x="132" y="${y}" width="${w}" height="7" rx="3"/>`).join("")}</g>
    <rect class="nf caret" x="266" y="154" width="8" height="12"/>${t(200, 212, "36 hours · national hackathon")}`,
};
art.guard = art.shield;
const html = (art[kind] ?? art.match)();
---
<svg class={`bart -${kind} ${dark ? "-dark" : ""}`} viewBox="0 0 400 240" aria-hidden="true" data-bart={kind} set:html={html} />

<style is:global>
  .bart { --b-ink: var(--c-ink); --b-paper: var(--c-white); --b-line: rgba(var(--c-ink-rgb), .22); --b-mute: var(--c-grey);
    width: 100%; height: 100%; overflow: visible; --px: 0; --py: 0; }
  .bart.-dark { --b-ink: var(--c-paper); --b-paper: rgb(13, 16, 20); --b-line: rgba(var(--c-white-rgb), .26); --b-mute: rgba(var(--c-white-rgb), .5); }
  .bart .p1 { translate: calc(var(--px) * 7px) calc(var(--py) * 5px); transition: translate .6s var(--e-cubic); }
  .bart .ln, .bart .ln path { fill: none; stroke: var(--b-line); stroke-width: 1.3; }
  .bart .dash { stroke-dasharray: 3 5; }
  .bart .nd { fill: var(--b-paper); stroke: var(--b-ink); stroke-width: 1.2; }
  .bart .nf { fill: var(--b-ink); }
  .bart .ac { fill: var(--c-accent); }
  .bart .acs { stroke: var(--c-accent); stroke-width: 2; }
  .bart .as { fill: none; stroke: var(--c-accent); stroke-width: 2.2; stroke-linejoin: round; }
  .bart .bar { fill: var(--b-line); } .bart .dim { fill: var(--b-line); opacity: .6; } .bart .dimf { fill: var(--b-line); }
  .bart .off { fill: none; stroke: var(--c-accent); stroke-dasharray: 3 3; }
  .bart text { font-family: var(--font-mono); }
  .bart .lbl { font-size: 9px; fill: var(--b-mute); text-anchor: middle; text-transform: uppercase; letter-spacing: .04em; }
  .bart .lbl.l { text-anchor: start; } .bart .lbl.ink { fill: var(--b-ink); } .bart .lbl.red { fill: var(--c-accent); }
  .bart .big { font: 600 22px var(--font-display); fill: var(--b-ink); letter-spacing: -.02em; }
  .bart .hub { font: 600 11px var(--font-display); fill: #fff; text-anchor: middle; letter-spacing: .04em; }
