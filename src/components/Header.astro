---
import { person, nav } from "../data/site";
import Logo from "./Logo.astro";
interface Props { home?: boolean }
const { home = true } = Astro.props;
const top = home ? "#top" : "/";
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class={`site-header ${home ? "" : "-inner"}`} data-header>
  <div class="grid site-header__w">
    <a href={top} class="site-header__mark" aria-label={home ? `${person.name} — back to top` : `${person.name} — home`} data-cursor="cursor-route">
      <Logo />
    </a>
    <a href={top} class="site-header__name" tabindex="-1" aria-hidden="true">{person.name}<sup>©</sup></a>
    <nav class="site-header__nav" aria-label="Primary">
      <button class="pill -round snd" type="button" data-sound-toggle aria-pressed="false" aria-label="Turn sound on" data-cursor="cursor-modal"><svg class="snd__on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" /><path class="w" d="M15.5 9a4.5 4.5 0 0 1 0 6M18 6.5a8 8 0 0 1 0 11" /></svg><svg class="snd__off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" /><path class="w" d="M16 9.5l5 5M21 9.5l-5 5" /></svg></button>
      <button class="pill -round" type="button" data-info-open aria-label="About Aryan" data-cursor="cursor-modal">i</button>
      {nav.map((n) => <a class={`pill ${here === n.href ? "-active" : ""}`} href={n.href} data-cursor={n.cursor} data-nav={n.href} aria-current={here === n.href ? "page" : undefined}>{n.label}</a>)}
      <button class="pill" type="button" data-pop-open="gallery" aria-haspopup="dialog" data-cursor="cursor-view">Gallery</button>
      <a class="pill" href={person.resume} target="_blank" rel="noopener" data-cursor="cursor-newtab">Resume <span aria-hidden="true">↗</span></a>
    </nav>
    <span class="site-header__progress t-mm" aria-hidden="true" data-scroll-pct>0%</span>
    <button class="site-header__burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-menu" data-menu-btn>
      <span></span><span></span>
    </button>
  </div>
  <!-- phone menu backdrop: dims and blurs background when menu opens -->
  <div class="site-menu__backdrop" data-menu-backdrop aria-hidden="true"></div>
  <!-- phone menu: frosted glass card with stacked options and utility line -->
  <nav class="site-menu" id="site-menu" aria-label="Menu" data-menu>
    <div class="site-menu__bar">
      <div class="site-menu__stack">
        {nav.map((n, k) => (
          <a class={`site-menu__i ${here === n.href ? "-active" : ""}`} href={n.href} style={`--k:${k}`} data-menu-link data-nav={n.href} aria-current={here === n.href ? "page" : undefined}>
            <span>{n.label}</span>
          </a>
        ))}
        <button class="site-menu__i" type="button" style={`--k:${nav.length}`} data-pop-open="gallery" aria-haspopup="dialog" data-menu-link>
          <span>Gallery</span>
        </button>
      </div>
      <div class="site-menu__bottom">
        <button class="site-menu__i site-menu__i--btn" type="button" style={`--k:${nav.length + 1}`} data-info-open data-menu-link aria-label="About Aryan">
          <span>Info</span>
        </button>
        <button class="site-menu__i site-menu__i--snd snd" type="button" style={`--k:${nav.length + 2}`} data-sound-toggle aria-pressed="false" aria-label="Turn sound on">
          <svg class="snd__on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" /><path class="w" d="M15.5 9a4.5 4.5 0 0 1 0 6M18 6.5a8 8 0 0 1 0 11" /></svg>
          <svg class="snd__off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" /><path class="w" d="M16 9.5l5 5M21 9.5l-5 5" /></svg>
        </button>
        <a class="site-menu__i site-menu__i--resume" href={person.resume} target="_blank" rel="noopener" style={`--k:${nav.length + 3}`} data-menu-link>
          <span>Resume</span> <span class="site-menu__arr" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </nav>
</header>

<style is:global>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    padding-top: var(--h4);
    pointer-events: none;
    transition: translate .6s var(--e-cubic), color .4s;
  }
  html:not(.-ready) .site-header { translate: 0 -100%; }
  .site-header.-away { translate: 0 -150%; }
  .site-header::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 200%;
    background: linear-gradient(180deg, rgba(var(--c-ink-rgb), .55), rgba(var(--c-ink-rgb), 0));
    opacity: 0; transition: opacity .5s; pointer-events: none; z-index: -1;
  }
  .site-header.-on-light { color: var(--c-ink); }
  .site-header.-on-light::before { opacity: 0; }
  html.-pop .site-header::before { opacity: 0 !important; }
  .site-header__w { align-items: center; }
  .site-header__w > * { pointer-events: auto; }

  .site-header__mark {
    --left: 0; --width: 1; grid-row: 1;
    justify-self: end;
    height: 1.6rem; display: grid; place-items: center; color: var(--c-accent);
    transition: scale .5s var(--e-bounce), height .6s var(--e-cubic);
  }
  .site-header__mark .logo { height: 1.15rem; width: auto; display: block; transition: height .6s var(--e-cubic); }
  .site-header__mark:hover { scale: 1.08; }
  .-scrolled .site-header__mark .logo { height: .95rem; }
  .site-header__name {
    --left: 1; --width: 3; grid-row: 1;
    font-size: var(--p); white-space: nowrap;
    opacity: 0; translate: 0 .4rem;
    transition: opacity .5s var(--e-cubic), translate .5s var(--e-cubic);
    padding-left: .4rem;
  }
  .site-header__name sup { font-size: .55em; margin-left: .1em; }
  .-scrolled .site-header__name { opacity: 1; translate: 0 0; }
  /* inner pages carry their own big sticky title — keep the wordmark out of its way */
  .site-header.-inner .site-header__name { display: none; }
  .-scrolled .site-header.-inner .site-header__mark .logo { height: 1.15rem; }
  /* active page: an accent ring and a small accent dot before the label */
  .site-header__nav .pill { transition: box-shadow .4s var(--e-cubic), background-color .3s, padding .4s var(--e-cubic); }
  .site-header__nav .pill.-active {
    padding-left: .6rem;
    box-shadow: inset 0 0 0 1.5px var(--c-accent), inset 0 1px 0 rgba(var(--c-white-rgb), .3), 0 .4rem 1.2rem rgba(var(--c-accent-rgb), .25);
  }
  .site-header__nav > * { flex-shrink: 0; } /* never squeeze the round pills */
  .site-header__nav .pill.-active::before { content: ""; width: .36rem; height: .36rem; border-radius: 50%; background: var(--c-accent); box-shadow: 0 0 .5rem var(--c-accent); }
  .site-header.-on-light .site-header__nav .pill.-active { box-shadow: inset 0 0 0 1.5px var(--c-accent), 0 .4rem 1.2rem rgba(var(--c-accent-rgb), .18); }
  .site-menu__i.-active { box-shadow: inset 0 0 0 1.5px var(--c-accent) !important; }
  .site-header__nav { --left: 7; --width: 5; grid-row: 1; display: flex; gap: .4rem; justify-content: flex-start; }
  /* narrower desktops: the row (now with Gallery) would run past the % readout — anchor it to the
     right and let it grow left into the empty columns instead */
  @media (min-width: 1024px) and (max-width: 1279px) { .site-header__nav { --left: 3; --width: 10; justify-content: flex-end; } }
  .site-header__progress { --left: 13; --width: 1; grid-row: 1; justify-self: end; }
  .site-header.-on-light .pill { color: var(--c-ink); background: rgba(var(--c-white-rgb), .55);
    box-shadow: inset 1px 0 0 rgba(var(--c-ink-rgb), .1), inset -1px 0 0 rgba(var(--c-ink-rgb), .1), inset 0 1px 0 rgba(var(--c-white-rgb), .9), 0 .4rem 1.2rem rgba(var(--c-ink-rgb), .05); }

  /* sound toggle: same size as the info pill; speaker icon swaps with the state */
  .snd svg { width: .95rem; height: .95rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; }
  .snd svg path:first-child { fill: currentColor; stroke: none; }
  .snd__off { display: block; } .snd__on { display: none; }
  html.-sound-on .snd__on { display: block; } html.-sound-on .snd__off { display: none; }
  html.-sound-on .snd__on .w { animation: sndWave 1.6s var(--e-smooth) infinite; }
  @keyframes sndWave { 50% { opacity: .35; } }
  html.-sound-on .site-header__nav .snd { box-shadow: inset 0 0 0 1.5px var(--c-accent); }
  /* phone menu */
  .site-header__burger, .site-menu, .site-menu__backdrop { display: none; }
  @media (max-width: 1023px) {
    .site-header__nav { display: none !important; }
    .site-header__burger {
      --left: 5; --width: 1; grid-row: 1; justify-self: end; pointer-events: auto; color: inherit;
      display: grid; place-content: center; gap: .32rem; width: 2.4rem; height: 2.4rem; border-radius: 50%;
      background: rgba(var(--c-white-rgb), .08); backdrop-filter: blur(14px) saturate(170%); -webkit-backdrop-filter: blur(14px) saturate(170%);
      box-shadow: inset 1px 0 0 rgba(var(--c-white-rgb), .18), inset -1px 0 0 rgba(var(--c-white-rgb), .18), inset 0 1px 0 rgba(var(--c-white-rgb), .3), 0 .4rem 1.2rem rgba(0, 0, 0, .2);
      transition: scale .4s var(--e-bounce), background-color .3s;
      z-index: 100; position: relative;
    }
    .site-header__burger:active { scale: .92; }
    .site-header__burger span { display: block; width: 1rem; height: 1.5px; border-radius: 2px; background: currentColor; transition: translate .5s var(--e-cubic), rotate .5s var(--e-cubic); }
    .site-header.-menu .site-header__burger span:first-child { translate: 0 .2rem; rotate: 45deg; }
    .site-header.-menu .site-header__burger span:last-child { translate: 0 -.2rem; rotate: -45deg; }
    .site-header.-on-light .site-header__burger { background: rgba(var(--c-white-rgb), .55); box-shadow: inset 0 0 0 1px rgba(var(--c-ink-rgb), .08), 0 .4rem 1.2rem rgba(var(--c-ink-rgb), .08); }

    /* Dimmed backdrop covering the whole viewport behind the menu */
    .site-menu__backdrop {
      display: block; position: fixed; inset: 0; width: 100vw; height: 100vh; height: 100dvh;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%);
      opacity: 0; pointer-events: none; z-index: 80;
      transition: opacity .35s var(--e-cubic);
    }
    .site-header.-menu .site-menu__backdrop { opacity: 1; pointer-events: auto; }
    .site-header.-on-light .site-menu__backdrop { background: rgba(14, 14, 17, 0.45); }

    /* Glassy menu container extending all the way to top */
    .site-menu {
      display: block; position: fixed; inset: 0 0 auto 0; width: 100%;
      pointer-events: none; z-index: 90;
    }
    .site-menu__bar {
      display: flex; flex-direction: column; gap: .45rem;
      padding: calc(var(--h6) + 3.4rem) var(--margin) 1.1rem var(--margin);
      border-radius: 0 0 1.8rem 1.8rem;
      background: linear-gradient(180deg, rgba(24, 24, 28, .84) 0%, rgba(18, 18, 22, .76) 100%);
      backdrop-filter: blur(32px) saturate(190%); -webkit-backdrop-filter: blur(32px) saturate(190%);
      border-bottom: 1px solid rgba(255, 255, 255, .16);
      box-shadow:
        inset 0 -1px 0 rgba(0, 0, 0, .4),
        0 2.5rem 5rem rgba(0, 0, 0, .68),
        0 .8rem 2rem rgba(0, 0, 0, .4);
      translate: 0 -0.8rem; opacity: 0;
      transition: opacity .3s var(--e-cubic), translate .35s var(--e-cubic);
    }
    .site-menu__stack {
      display: flex; flex-direction: column; gap: .45rem; width: 100%;
    }
    .site-menu__bottom {
      display: flex; align-items: center; gap: .45rem; width: 100%; margin-top: .15rem;
    }
    .site-menu__i {
      display: flex; align-items: center; justify-content: center; height: 3.1rem; padding: 0 1.2rem;
      border-radius: .5rem;
      font-size: 1.05rem; font-weight: 500; letter-spacing: -0.015em; color: var(--c-paper); white-space: nowrap;
      background: rgba(255, 255, 255, .06);
      border: 1px solid rgba(255, 255, 255, .1);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .16), 0 2px 6px rgba(0, 0, 0, .18);
      opacity: 0; translate: 0 -.35rem;
      transition: opacity .25s var(--e-cubic), translate .25s var(--e-cubic), background-color .2s, border-color .2s, scale .16s;
    }
    .site-menu__i:active {
      scale: .988;
      background: rgba(255, 255, 255, .14);
      border-color: rgba(255, 255, 255, .22);
    }
    .site-menu__i.-active {
      background: rgba(var(--c-accent-rgb), .22); border-color: rgba(var(--c-accent-rgb), .5);
      box-shadow: inset 0 0 0 1.5px var(--c-accent), 0 .4rem 1.2rem rgba(var(--c-accent-rgb), .25) !important;
    }
    .site-menu__i.-active::before {
      content: ""; width: .36rem; height: .36rem; border-radius: 50%; background: var(--c-accent); box-shadow: 0 0 .5rem var(--c-accent);
      margin-right: .55rem;
    }
    .site-menu__stack .site-menu__i { width: 100%; }
    .site-menu__i--btn { flex: 1; height: 2.9rem; border-radius: .5rem; }
    .site-menu__i--snd { flex: 0 0 3.2rem; height: 2.9rem; border-radius: .5rem; padding: 0; }
    .site-menu__i--resume { flex: 1.35; height: 2.9rem; border-radius: .5rem; gap: .35rem; }
    .site-menu__arr { font-size: .85em; opacity: .8; }

    .site-header.-menu .site-menu { pointer-events: auto; }
    .site-header.-menu .site-menu__bar {
      translate: 0 0; opacity: 1;
      transition: opacity .35s var(--e-cubic), translate .4s var(--e-cubic);
    }
    .site-header.-menu .site-menu__i {
      opacity: 1; translate: 0 0;
      transition: opacity .35s var(--e-cubic), translate .35s var(--e-cubic), background-color .2s, border-color .2s, scale .16s;
      transition-delay: calc(.04s + var(--k) * .025s);
    }

    /* On light theme */
    .site-header.-on-light .site-menu__bar {
      background: linear-gradient(180deg, rgba(255, 255, 255, .92) 0%, rgba(245, 245, 243, .85) 100%);
      border-bottom: 1px solid rgba(0, 0, 0, .09);
      box-shadow:
        inset 0 -1px 0 rgba(0, 0, 0, .05),
        0 2.5rem 5rem rgba(0, 0, 0, .15),
        0 .8rem 2rem rgba(0, 0, 0, .07);
    }
    .site-header.-on-light .site-menu__i {
      color: var(--c-ink);
      background: rgba(0, 0, 0, .04);
      border-color: rgba(0, 0, 0, .07);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .9), 0 2px 6px rgba(0, 0, 0, .04);
    }
    .site-header.-on-light .site-menu__i:active {
      background: rgba(0, 0, 0, .08);
      border-color: rgba(0, 0, 0, .12);
    }
    .site-header.-on-light .site-menu__i.-active {
      color: var(--c-accent);
      background: rgba(var(--c-accent-rgb), .12); border-color: rgba(var(--c-accent-rgb), .4);
      box-shadow: inset 0 0 0 1.5px var(--c-accent), 0 .4rem 1.2rem rgba(var(--c-accent-rgb), .15) !important;
    }
  }
  @media (max-width: 1023px) {
    .site-header { padding-top: var(--h6); }
    .site-header__w { position: relative; z-index: 100; }
    .site-header__mark { --left: 0; justify-self: start; z-index: 101; position: relative; }
    .site-header__name { display: none; }
    .site-header__progress { display: none; }
    html.-pop .site-header__burger { opacity: 0; pointer-events: none; }
  }
  @media (max-width: 640px) {
    .site-menu { inset: 0 0 auto 0; }
    .site-menu__bar {
      gap: .38rem;
      padding: calc(var(--h6) + 3.2rem) var(--margin) 1rem var(--margin);
      border-radius: 0 0 1.6rem 1.6rem;
    }
    .site-menu__stack { gap: .38rem; }
    .site-menu__bottom { gap: .38rem; margin-top: .1rem; }
    .site-menu__stack .site-menu__i { height: 2.95rem; font-size: 1rem; border-radius: .45rem; }
    .site-menu__i--btn, .site-menu__i--resume { height: 2.8rem; font-size: .92rem; border-radius: .45rem; }
    .site-menu__i--snd { height: 2.8rem; flex: 0 0 3.1rem; border-radius: .45rem; }
  }
</style>
