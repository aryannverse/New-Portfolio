---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Stage from "../components/Stage.astro";
import Story from "../components/Story.astro";
import Listen from "../components/Listen.astro";
import Bloom from "../components/Bloom.astro";
import Approach from "../components/Approach.astro";
import Work from "../components/Work.astro";
import Personalities from "../components/Personalities.astro";
import Experience from "../components/Experience.astro";
import Footer from "../components/Footer.astro";
---
<Base>
  <div class="tree-bg" data-tree aria-hidden="true"><canvas></canvas></div>
  <canvas class="verse" data-verse-canvas data-pin-on-pop aria-hidden="true"></canvas>
  <div class="frame" data-frame data-pin-on-pop aria-hidden="true"><i></i></div>
  <Hero />
  <Stage />
  <Story />
  <div class="light-wrap">
    <Listen />
    <Bloom />
    <Approach />
    <Work />
    <Personalities />
    <Experience />
  </div>
  <Footer />
</Base>

<style is:global>
  /* generative ink tree behind the hero title (src/scripts/tree.ts) */
  .tree-bg {
    position: absolute; z-index: 1; top: 0; left: 50%; width: min(46vw, 64rem); height: calc(var(--vh) * 74);
    translate: calc(-50% + var(--tree-x, 0vw)) var(--tree-y, 0vh); pointer-events: none;
    clip-path: polygon(24% 0, 76% 0, 100% 24%, 100% 76%, 76% 100%, 24% 100%, 0 76%, 0 24%);
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 98%); mask-image: linear-gradient(180deg, #000 55%, transparent 98%);
  }
  .tree-bg canvas { width: 100%; height: 100%; display: block; opacity: .62; }
  @media (max-width: 1023px) { .tree-bg { width: 92vw; height: calc(var(--vh) * 58); } }
  /* the rounded window: black bars → rim (src/scripts/frame.ts) */
  .frame { position: fixed; inset: 0; z-index: 80; pointer-events: none; overflow: hidden; visibility: hidden; }
  .frame i { position: absolute; inset: 0; box-shadow: 0 0 0 200vmax var(--c-ink); }
  .verse { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 25; pointer-events: none; }
</style>

<script>
  import { initStory } from "../scripts/story";
  import { initFall } from "../scripts/fall";
  import { initExperience } from "../scripts/experience";
  import { initPluck } from "../scripts/pluck";
  import { initTree } from "../scripts/tree";
  import { initFrame } from "../scripts/frame";
  import { onPage } from "../scripts/life";
  import { heroDone } from "../scripts/hero-ready";
  onPage(() => {

    const tree = document.querySelector<HTMLElement>("[data-tree]"); if (tree) initTree(tree);

    const verse = document.querySelector<HTMLCanvasElement>("[data-verse-canvas]");
    if (verse) {
      // 3D MacBook (src/scripts/laptop.ts) — defer WebGL until the browser is idle so first paint stays fast
      // behind the preloader it boots straight away (the preloader waits for its first frame)
      const go = () => import("../scripts/laptop").then((m) => m.initLaptop(verse)).catch(heroDone);
      if (document.documentElement.classList.contains("-preload")) go();
      else "requestIdleCallback" in window ? requestIdleCallback(go, { timeout: 800 }) : setTimeout(go, 200);
    }
    // Toolkit wall MacBook — reuses the same model download; boots when the wall is ~1.5 screens away
    const wall = document.querySelector<HTMLCanvasElement>("[data-toolkit-canvas]");
    if (wall) {
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        import("../scripts/toolkit3d").then((m) => m.initToolkit3d(wall));
      }, { rootMargin: "150% 0px" });
      io.observe(wall);
    }
    const story = document.querySelector<HTMLElement>("[data-story]"); if (story) initStory(story);
    const frame = document.querySelector<HTMLElement>("[data-frame]"); if (frame && story) initFrame(frame, story);
    document.querySelectorAll<HTMLCanvasElement>("[data-fall]").forEach(initFall);
    const exp = document.querySelector<HTMLElement>("[data-exp]"); if (exp) initExperience(exp);
    const pluck = document.querySelector<SVGSVGElement>("[data-pluck]"); if (pluck) initPluck(pluck);
  });
</script>
